<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <Authors>珠音茉白/東方管制塔開発部</Authors>
	  <Product>東方管制塔 EX Game Process Control</Product>
	  <Copyright>Copyright © 2026 $(Authors)</Copyright>
	  <Version>$(VersionPrefix)$(VersionSuffix)</Version>
	  <VersionPrefix>0.1.0</VersionPrefix>
	  <VersionSuffix>alpha.1</VersionSuffix>
	  <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="exceptions\ProcessNotFoundException.fs" />
    <Compile Include="GameProcessManager.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThGameMgr.Ex.Core\ThGameMgr.Ex.Core.fsproj" />
    <ProjectReference Include="..\ThGameMgr.Ex.Win32API\ThGameMgr.Ex.Win32API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="GameWindowPosition.fs" />
    <Compile Include="GameWindowSizes.fs" />
    <Compile Include="GameWindowManager.fs" />
    <Compile Include="GameAudioManager.fs" />
    <Folder Include="Exceptions\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
  </ItemGroup>

</Project>
