<Window x:Class="ThGameMgr.Ex.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThGameMgr.Ex.Dialogs"
        mc:Ignorable="d"
        Title="InputDialog" Height="169" Width="362" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Label Content="テキストを入力(_I):" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox
            x:Name="InputBox"
            Margin="10,41,10,0" TextWrapping="NoWrap" MaxLines="1" Text="" VerticalAlignment="Top"/>
        <Button
            x:Name="OKButton"
            Width="90" Height="24"
            IsDefault="True"
            Content="_OK" HorizontalAlignment="Right" Margin="0,0,105,10" VerticalAlignment="Bottom" Click="OKButtonClick"/>
        <Button 
            x:Name="CancelButton"
            Width="90" Height="24"
            IsCancel="True"
            Content="キャンセル(_C)" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Click="CancelButtonClick"/>

    </Grid>
</Window>
