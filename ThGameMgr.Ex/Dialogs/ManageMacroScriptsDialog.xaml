<Window x:Class="ThGameMgr.Ex.Dialogs.ManageMacroScriptsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThGameMgr.Ex.Dialogs"
        mc:Ignorable="d"
        Title="マクロスクリプトの管理" Height="358" Width="533" WindowStartupLocation="CenterOwner">
    <Grid>
        <Label Content="マクロスクリプトファイルの一覧:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <ListBox x:Name="MacroScriptsFileListBox" Margin="10,41,105,10" />
        <Button x:Name="EditButton"
            Width="90" Height="24"
            Content="編集(_E)" HorizontalAlignment="Right" Margin="0,70,10,0" VerticalAlignment="Top"/>
        <Button x:Name="CreateButton"
            Content="追加(_A)" HorizontalAlignment="Right" Margin="0,41,10,0" VerticalAlignment="Top" Width="90" Height="24" Click="CreateButtonClick"/>
        <Button x:Name="DeleteButton"
            Content="削除(_D)" HorizontalAlignment="Right" Margin="0,99,10,0" VerticalAlignment="Top" Height="24" Width="90"/>

    </Grid>
</Window>
