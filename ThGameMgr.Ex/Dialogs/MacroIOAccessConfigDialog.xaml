<Window x:Class="ThGameMgr.Ex.Dialogs.MacroIOAccessConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThGameMgr.Ex.Dialogs"
        mc:Ignorable="d"
        Title="マクロがアクセス可能なディレクトリを設定" Height="316" Width="494" WindowStartupLocation="CenterOwner">
    <Grid>
        <ListBox x:Name="DirectoryListBox"
            Margin="10,10,105,10"/>
        <Button x:Name="AddButton"
            Width="90" Height="24"
            Content="追加" HorizontalAlignment="Right" Margin="0,10,10,0" VerticalAlignment="Top" Click="AddButtonClick"/>
        <Button x:Name="SaveButton"
                Content="保存(_S)" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" 
                Width="90" Height="24" Click="SaveButtonClick"/>

    </Grid>
</Window>
