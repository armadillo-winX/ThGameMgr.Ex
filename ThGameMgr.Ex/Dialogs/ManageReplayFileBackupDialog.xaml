<Window x:Class="ThGameMgr.Ex.Dialogs.ManageReplayFileBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThGameMgr.Ex.Dialogs"
        mc:Ignorable="d"
        Title="リプレイファイルのバックアップ" Height="373" Width="553"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <TextBlock 
            x:Name="DescriptionBlock"
            HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" 
            Text="GameName のリプレイファイルバックアップ" VerticalAlignment="Top"/>
        <DataGrid x:Name="BackupFilesDataGrid" Margin="10,31,10,38">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名前" Width="175" IsReadOnly="True"
                                Binding="{Binding BackupName}"/>
                <DataGridTextColumn Header="作成日時" Width="150" IsReadOnly="True"
                                Binding="{Binding Timestamp}"/>
                <DataGridTextColumn Header="コメント" Width="200" IsReadOnly="True"
                                Binding="{Binding Comment}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button 
            x:Name="RestoreButton"
            Width="120" Height="24"
            Content="復元(_R)" HorizontalAlignment="Right" Margin="0,0,10,9" VerticalAlignment="Bottom"/>
        <TextBlock
            x:Name="MessageBlock"
            FontSize="14"
            Foreground="Black"
            Visibility="Hidden"
            HorizontalAlignment="Center" TextWrapping="Wrap" Text="ErrorMessage" VerticalAlignment="Center" Margin="0,0,0,0"/>
        <Image x:Name="ErrorImage"
            Visibility="Hidden"
            HorizontalAlignment="Center" Height="32" Margin="0,-55,0,0" VerticalAlignment="Center"
            Width="32" Source="/Images/ErrorIcon32x32.png" Stretch="None"/>
    </Grid>
</Window>
