<Window x:Class="ThGameMgr.Ex.Dialogs.RestoreReplayFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThGameMgr.Ex.Dialogs"
        mc:Ignorable="d"
        Title="リプレイファイルの復元" Height="170" Width="325"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid>
        <Label Content="リプレイファイル名:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox 
            x:Name="NameBox" Margin="10,41,35,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top"
            MaxLines="1"/>
        <TextBlock HorizontalAlignment="Right" Margin="0,42,10,0" TextWrapping="Wrap" Text=".rpy" VerticalAlignment="Top"/>
        <Button 
            x:Name="RestoreButton"
            Width="90" Height="24"
            Content="復元(_R)" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Click="RestoreButtonClick"/>
        <CheckBox x:Name="AllowOverwriteCheckBox"
            Content="上書きを許可" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom"/>

    </Grid>
</Window>
