<Window x:Class="ThGameMgr.Ex.Dialogs.CreateReplayFileBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThGameMgr.Ex.Dialogs"
        mc:Ignorable="d"
        Title="リプレイファイルのバックアップ" Height="264" Width="277"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Label Content="バックアップの名前:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox 
            x:Name="NameBox" Margin="10,41,10,0" TextWrapping="NoWrap" Text=""
            MaxLines="1" VerticalAlignment="Top"/>
        <Button x:Name="CreateBackupButton"
            Width="120" Height="24"
            IsDefault="True"
            Content="バックアップの作成" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Click="CreateBackupButtonClick"/>
        <Label Content="コメント:" HorizontalAlignment="Left" Margin="10,64,0,0" VerticalAlignment="Top"/>
        <TextBox
            x:Name="CommentBox"
            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
            AcceptsReturn="True"
            Margin="10,95,10,39" TextWrapping="NoWrap" Text=""/>

    </Grid>
</Window>
